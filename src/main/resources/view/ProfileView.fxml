<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.ProfileController"
      spacing="0" styleClass="content-area"
      stylesheets="@../assets/style.css"
      alignment="TOP_LEFT">

    <!-- Page Header -->
    <VBox spacing="4" style="-fx-padding: 0 0 24 0;">
        <Label text="Mon Profil" styleClass="page-title"/>
        <Label text="Consultez et modifiez vos informations personnelles." styleClass="page-subtitle"/>
    </VBox>

    <!-- Profile Card -->
    <VBox styleClass="card" spacing="24" maxWidth="560">

        <!-- Avatar + Name header -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <!-- Avatar circle -->
            <StackPane prefWidth="72" prefHeight="72"
                       style="-fx-background-color: linear-gradient(to bottom right, #6366f1, #8b5cf6); -fx-background-radius: 36;">
                <Label text="👤" style="-fx-font-size: 32px;"/>
            </StackPane>
            <VBox spacing="4">
                <Label text="Profil Utilisateur" styleClass="card-title"/>
                <Label text="Vos informations sont visibles par l'administrateur."
                       style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
            </VBox>
        </HBox>

        <!-- Divider -->
        <Region prefHeight="1" maxWidth="Infinity"
                style="-fx-background-color: #f1f5f9;"/>

        <!-- Info Grid -->
        <GridPane hgap="20" vgap="16">
            <columnConstraints>
                <ColumnConstraints minWidth="80" prefWidth="110"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Nom :"     GridPane.rowIndex="0" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold; -fx-text-fill: #64748b; -fx-font-size: 13px;"/>
            <Label fx:id="nomLabel"    GridPane.rowIndex="0" GridPane.columnIndex="1"
                   style="-fx-font-size: 14px; -fx-text-fill: #0f172a; -fx-font-weight: bold;"/>

            <Label text="Prénom :"  GridPane.rowIndex="1" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold; -fx-text-fill: #64748b; -fx-font-size: 13px;"/>
            <Label fx:id="prenomLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"
                   style="-fx-font-size: 14px; -fx-text-fill: #0f172a; -fx-font-weight: bold;"/>

            <Label text="Email :"   GridPane.rowIndex="2" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold; -fx-text-fill: #64748b; -fx-font-size: 13px;"/>
            <Label fx:id="emailLabel"  GridPane.rowIndex="2" GridPane.columnIndex="1"
                   style="-fx-font-size: 14px; -fx-text-fill: #0f172a;"/>

            <Label text="Rôle :"    GridPane.rowIndex="3" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold; -fx-text-fill: #64748b; -fx-font-size: 13px;"/>
            <Label fx:id="roleLabel"   GridPane.rowIndex="3" GridPane.columnIndex="1"
                   style="-fx-font-size: 13px; -fx-text-fill: #6366f1; -fx-font-weight: bold;
                          -fx-background-color: #eef2ff; -fx-background-radius: 20; -fx-padding: 3 12;"/>
        </GridPane>

        <!-- Edit Button -->
        <HBox alignment="CENTER_LEFT">
            <Button text="✏️  Modifier mon Profil" onAction="#editProfile"
                    style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-padding: 12 28; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 13px;"/>
        </HBox>

    </VBox>

</VBox>
