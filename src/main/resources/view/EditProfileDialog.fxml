<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.EditProfileDialogController"
            stylesheets="@../assets/style.css"
            style="-fx-background-color: white; -fx-padding: 0;">
    <content>
        <VBox spacing="20" style="-fx-padding: 24;">

            <!-- Dialog Header -->
            <VBox spacing="6">
                <Label text="✏️  Modifier le Profil" styleClass="page-title" style="-fx-font-size: 20px;"/>
                <Label text="Mettez à jour vos informations personnelles."
                       style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
            </VBox>

            <!-- Divider -->
            <Region prefHeight="1" maxWidth="Infinity" style="-fx-background-color: #f1f5f9;"/>

            <!-- Form -->
            <GridPane hgap="16" vgap="14" prefWidth="400">
                <columnConstraints>
                    <ColumnConstraints minWidth="80" prefWidth="100"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Nom :"    GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-field-label"/>
                <TextField fx:id="nomField"    GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Votre nom"/>

                <Label text="Prénom :" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-field-label"/>
                <TextField fx:id="prenomField" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Votre prénom"/>

                <Label text="Email :"  GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-field-label"/>
                <TextField fx:id="emailField"  GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="votre@email.com"/>

                <Label text="Rôle :"   GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-field-label"/>
                <TextField fx:id="roleField"   GridPane.rowIndex="3" GridPane.columnIndex="1"
                           editable="false"
                           style="-fx-background-color: #f8fafc; -fx-text-fill: #64748b; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
            </GridPane>
        </VBox>
    </content>
    <buttonTypes>
        <ButtonType fx:id="okButton" text="✅  Appliquer" buttonData="OK_DONE"/>
        <ButtonType text="Annuler" buttonData="CANCEL_CLOSE"/>
    </buttonTypes>
</DialogPane>
