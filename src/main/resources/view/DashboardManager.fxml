<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.DashboardManagerController"
            stylesheets="@../assets/style.css" prefWidth="1200" prefHeight="800">

    <!-- ══ SIDEBAR ══ -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240" spacing="0">
            <!-- Logo area -->
            <VBox spacing="2" style="-fx-padding: 28 20 20 20;">
                <Label text="⚡ PlanUp" styleClass="sidebar-logo" style="-fx-padding: 0;"/>
                <Label text="Espace Chef de Projet" styleClass="sidebar-logo-sub" style="-fx-padding: 0;"/>
            </VBox>
            <Region prefHeight="1" style="-fx-background-color: #1e293b;" maxWidth="Infinity"/>
            <VBox style="-fx-padding: 16 16 0 16;">
                <VBox styleClass="sidebar-user-box" spacing="2">
                    <Label fx:id="userInfoLabel" text="Chef de Projet" styleClass="sidebar-user-name" wrapText="true"/>
                    <Label text="💼 MANAGER" styleClass="sidebar-user-role"/>
                </VBox>
            </VBox>
            <Label text="NAVIGATION" styleClass="sidebar-section-label"/>
            
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0; -fx-border-width: 0;">
                <VBox spacing="2" style="-fx-padding: 0 12;">
                    <Button text="📁  Projets"  onAction="#showProjects" maxWidth="Infinity" styleClass="sidebar-button"/>
                    <Button text="🔄  Sprints"   onAction="#showSprints"  maxWidth="Infinity" styleClass="sidebar-button"/>
                    <Button text="✅  Tâches"     onAction="#showTasks"    maxWidth="Infinity" styleClass="sidebar-button"/>
                    <Button text="📊  Statistiques" onAction="#showStatistics" maxWidth="Infinity" styleClass="sidebar-button"/>
                    <Button text="🏖️  Gestion des Congés" onAction="#showCongesManagement" maxWidth="Infinity" styleClass="sidebar-button"/>
                </VBox>
            </ScrollPane>

            <VBox spacing="6" style="-fx-padding: 12 12 20 12;">
                <Button text="👤  Mon Profil"   onAction="#showProfile" maxWidth="Infinity" styleClass="sidebar-button-profile"/>
                <Button text="🚪  Déconnexion"  onAction="#logout"      maxWidth="Infinity" styleClass="sidebar-button-logout"/>
            </VBox>
        </VBox>
    </left>

    <!-- ══ MAIN CONTENT ══ -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <VBox spacing="28" alignment="TOP_LEFT">

                <VBox spacing="6">
                    <Label text="Tableau de Bord" styleClass="page-title"/>
                    <Label text="Gérez vos projets, sprints et affectations d'équipe." styleClass="page-subtitle"/>
                </VBox>

                <VBox styleClass="welcome-banner" spacing="6">
                    <Label text="📊 Bienvenue dans l'Espace Manager" styleClass="welcome-title"/>
                    <Label text="Planifiez les sprints, gérez les projets et assignez les tâches à votre équipe." styleClass="welcome-subtitle"/>
                </VBox>

                <HBox spacing="16">
                    <VBox styleClass="stat-card" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="📁" style="-fx-font-size: 24px;"/>
                        <Label text="Projets" styleClass="stat-label"/>
                        <Button text="Gérer" onAction="#showProjects"
                                style="-fx-background-color: #eef2ff; -fx-text-fill: #4f46e5; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 14;"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="🔄" style="-fx-font-size: 24px;"/>
                        <Label text="Sprints" styleClass="stat-label"/>
                        <Button text="Gérer" onAction="#showSprints"
                                style="-fx-background-color: #f0fdf4; -fx-text-fill: #059669; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 14;"/>
                    </VBox>
                    <VBox styleClass="stat-card" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="✅" style="-fx-font-size: 24px;"/>
                        <Label text="Tâches" styleClass="stat-label"/>
                        <Button text="Gérer" onAction="#showTasks"
                                style="-fx-background-color: #fef3c7; -fx-text-fill: #d97706; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 14;"/>
                    </VBox>
                </HBox>

            </VBox>
        </StackPane>
    </center>

</BorderPane>
