<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.DashboardRHController"
            stylesheets="@../assets/style.css" prefWidth="1280" prefHeight="800">

    <!-- ══════════════════════════════════════════════════════════
         SIDEBAR
    ══════════════════════════════════════════════════════════ -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240" spacing="0">

            <VBox spacing="2" style="-fx-padding: 28 20 20 20;">
                <Label text="⚡ PlanUp" styleClass="sidebar-logo" style="-fx-padding: 0;"/>
                <Label text="Espace RH" styleClass="sidebar-logo-sub" style="-fx-padding: 0;"/>
            </VBox>

            <Region prefHeight="1" style="-fx-background-color: #1e293b;" maxWidth="Infinity"/>

            <VBox style="-fx-padding: 16 16 0 16;">
                <VBox styleClass="sidebar-user-box" spacing="2">
                    <Label fx:id="userInfoLabel" text="Responsable RH" styleClass="sidebar-user-name" wrapText="true"/>
                    <Label text="🧑‍💼 RH" styleClass="sidebar-user-role"/>
                </VBox>
            </VBox>

            <Label text="NAVIGATION" styleClass="sidebar-section-label"/>

            <VBox spacing="2" style="-fx-padding: 0 12;" VBox.vgrow="ALWAYS">
                <Button text="💼  Offres d'emploi"    onAction="#showOffres"           maxWidth="Infinity" styleClass="sidebar-button"/>
                <Button text="🏖️  Gestion des Congés" onAction="#showCongesManagement" maxWidth="Infinity" styleClass="sidebar-button"/>
                <Button text="📅  Planning Projets"    onAction="#showProjects"         maxWidth="Infinity" styleClass="sidebar-button"/>
                <Button text="⚡  Planning Sprints"    onAction="#showSprints"          maxWidth="Infinity" styleClass="sidebar-button"/>
            </VBox>

            <VBox spacing="6" style="-fx-padding: 12;">
                <Button text="👤  Mon Profil"   onAction="#showProfile" maxWidth="Infinity" styleClass="sidebar-button-profile"/>
                <Button text="🚪  Déconnexion"  onAction="#logout"      maxWidth="Infinity" styleClass="sidebar-button-logout"/>
            </VBox>

        </VBox>
    </left>

    <!-- ══════════════════════════════════════════════════════════
         MAIN CONTENT
    ══════════════════════════════════════════════════════════ -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">

            <!-- ── Conges Management View ── -->
            <VBox fx:id="congesView" spacing="20" visible="false">

                <VBox spacing="4">
                    <Label text="Gestion des Congés" styleClass="page-title"/>
                    <Label text="Demandez, acceptez ou refusez les congés des employés." styleClass="page-subtitle"/>
                </VBox>

                <!-- Form Card -->
                <VBox styleClass="card" spacing="16">
                    <Label text="📋  Nouvelle Demande de Congé" styleClass="card-title"/>

                    <GridPane hgap="16" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="10" prefWidth="130"/>
                            <ColumnConstraints minWidth="10" prefWidth="200" hgrow="SOMETIMES"/>
                            <ColumnConstraints minWidth="10" prefWidth="110"/>
                            <ColumnConstraints minWidth="10" prefWidth="200" hgrow="SOMETIMES"/>
                            <ColumnConstraints minWidth="10" prefWidth="110"/>
                            <ColumnConstraints minWidth="10" prefWidth="200" hgrow="SOMETIMES"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="10" prefHeight="38" vgrow="SOMETIMES"/>
                            <RowConstraints minHeight="10" prefHeight="38" vgrow="SOMETIMES"/>
                            <RowConstraints minHeight="10" prefHeight="38" vgrow="SOMETIMES"/>
                            <RowConstraints minHeight="10" prefHeight="38" vgrow="SOMETIMES"/>
                        </rowConstraints>
                        <children>
                            <Label text="CIN Employé :" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="form-field-label"/>
                            <TextField fx:id="txtCinEmploye" prefHeight="36" promptText="Ex: 12345678"  GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label text="Type :" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="form-field-label"/>
                            <ComboBox fx:id="cbType" prefHeight="36" prefWidth="200" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                            <Label text="Date début :" GridPane.columnIndex="4" GridPane.rowIndex="0" styleClass="form-field-label"/>
                            <DatePicker fx:id="dpDateDebut" prefHeight="36" prefWidth="200" promptText="JJ/MM/AAAA" GridPane.columnIndex="5" GridPane.rowIndex="0"/>

                            <Label text="Date fin :" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="form-field-label"/>
                            <DatePicker fx:id="dpDateFin" prefHeight="36" prefWidth="200" promptText="JJ/MM/AAAA" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                            <Label text="Nbr jours :" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="form-field-label"/>
                            <TextField fx:id="txtNbrJours" prefHeight="36" promptText="Ex: 5" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label text="Justificatif :" GridPane.columnIndex="2" GridPane.rowIndex="2" styleClass="form-field-label"/>
                            <TextField fx:id="txtDjon" prefHeight="36" promptText="Description ou chemin" GridPane.columnIndex="3" GridPane.columnSpan="3" GridPane.rowIndex="2"/>

                            <Label text="Congé soldé :" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="form-field-label"/>
                            <TextField fx:id="txtCongeSolde" prefHeight="36" promptText="0 ou 1" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        </children>
                    </GridPane>
                </VBox>

                <!-- Filter row -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="🔍  Filtrer par statut :" styleClass="form-field-label"/>
                    <ComboBox fx:id="filterStatutCombo" promptText="Tous les statuts" onAction="#filterConges"
                              style="-fx-min-width: 180px; -fx-background-radius: 8; -fx-border-radius: 8;"/>
                </HBox>

                <!-- Table Card -->
                <VBox VBox.vgrow="ALWAYS" styleClass="card" spacing="14">
                    <Label text="Liste des Congés" styleClass="card-title"/>

                    <TableView fx:id="congesTable" prefHeight="280" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="idCongeColumn"   text="ID"         prefWidth="60"/>
                            <TableColumn fx:id="employeColumn"   text="Employé"    prefWidth="180"/>
                            <TableColumn fx:id="typeColumn"      text="Type"       prefWidth="120"/>
                            <TableColumn fx:id="dateDebutColumn" text="Date Début" prefWidth="120"/>
                            <TableColumn fx:id="dateFinColumn"   text="Date Fin"   prefWidth="120"/>
                            <TableColumn fx:id="nbrJoursColumn"  text="Jours"      prefWidth="70"/>
                            <TableColumn fx:id="statutColumn"    text="Statut"     prefWidth="120"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="10">
                    <Button mnemonicParsing="false" onAction="#demanderConge"  prefHeight="42" prefWidth="160"
                            text="📝  Demander"
                            style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;"/>
                    <Button mnemonicParsing="false" onAction="#annulerConge"   prefHeight="42" prefWidth="190"
                            text="↩  Annuler (EN_ATTENTE)"
                            style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;"/>
                    <Button mnemonicParsing="false" onAction="#accepterConge"  prefHeight="42" prefWidth="160"
                            text="✅  Accepter (RH)"
                            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;"/>
                    <Button mnemonicParsing="false" onAction="#refuserConge"   prefHeight="42" prefWidth="160"
                            text="❌  Refuser (RH)"
                            style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;"/>
                    <Button mnemonicParsing="false" onAction="#refreshConges"  prefHeight="42" prefWidth="56"
                            text="⟳"
                            style="-fx-background-color: #06b6d4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 18px;"/>
                </HBox>

            </VBox>

            <!-- ── Welcome / Offre emploi View ── -->
            <VBox fx:id="welcomeView" spacing="20" alignment="TOP_LEFT" visible="true">

                <VBox spacing="4">
                    <Label text="Gestion RH" styleClass="page-title"/>
                    <Label text="Gérez les offres d'emploi et les congés de l'équipe." styleClass="page-subtitle"/>
                </VBox>

                <VBox styleClass="welcome-banner" spacing="6">
                    <Label text="🧑‍💼 Bienvenue dans l'Espace RH" styleClass="welcome-title"/>
                    <Label text="Publiez des offres, gérez les candidatures et les demandes de congé." styleClass="welcome-subtitle"/>
                </VBox>

                <!-- Offre Form Card -->
                <VBox styleClass="card" spacing="16" VBox.vgrow="ALWAYS">
                    <Label text="💼  Gestion des Offres d'Emploi" styleClass="card-title"/>

                    <!-- Form -->
                    <VBox spacing="14">
                        <HBox spacing="16">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Titre" styleClass="form-field-label"/>
                                <TextField fx:id="titreField" promptText="Titre de l'offre"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Type de contrat" styleClass="form-field-label"/>
                                <ComboBox fx:id="typeContratCombo" promptText="Selectionner" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Salaire" styleClass="form-field-label"/>
                                <TextField fx:id="salaireField" promptText="Ex: 2500 TND"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Localisation" styleClass="form-field-label"/>
                                <TextField fx:id="localisationField" promptText="Ville, Pays"/>
                            </VBox>
                        </HBox>
                        <HBox spacing="16">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Profil recherché" styleClass="form-field-label"/>
                                <TextField fx:id="profilField" promptText="Ex: Développeur Java Senior"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Statut" styleClass="form-field-label"/>
                                <ComboBox fx:id="statutCombo" promptText="Sélectionner" maxWidth="Infinity"/>
                            </VBox>
                        </HBox>
                        <VBox spacing="5">
                            <Label text="Description" styleClass="form-field-label"/>
                            <TextArea fx:id="descriptionArea" promptText="Description détaillée de l'offre..." prefRowCount="3"/>
                        </VBox>

                        <!-- Action Buttons -->
                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Button text="➕  Ajouter"     onAction="#handleAdd"
                                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            <Button text="✏️  Modifier"    onAction="#handleUpdate"
                                    style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            <Button text="🗑️  Supprimer"  onAction="#handleDelete"
                                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            <Button text="🔄  Réinitialiser" onAction="#handleClear"
                                    style="-fx-background-color: #e2e8f0; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>

                    <!-- Table -->
                    <TableView fx:id="offreTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="ID"               prefWidth="50">
                                <cellValueFactory><PropertyValueFactory property="idOffre"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Titre"            prefWidth="160">
                                <cellValueFactory><PropertyValueFactory property="titre"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Contrat"          prefWidth="110">
                                <cellValueFactory><PropertyValueFactory property="typeContrat"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Salaire"          prefWidth="100">
                                <cellValueFactory><PropertyValueFactory property="salaire"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Localisation"     prefWidth="130">
                                <cellValueFactory><PropertyValueFactory property="localisation"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Statut"           prefWidth="100">
                                <cellValueFactory><PropertyValueFactory property="statut"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Date Publication" prefWidth="130">
                                <cellValueFactory><PropertyValueFactory property="datePublication"/></cellValueFactory>
                            </TableColumn>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                </VBox>

            </VBox>

        </StackPane>
    </center>

</BorderPane>
