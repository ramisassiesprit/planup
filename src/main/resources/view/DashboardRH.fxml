<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.DashboardRHController"
            stylesheets="@../assets/style.css" prefWidth="1200" prefHeight="800">
    
    <!-- Sidebar -->
    <left>
        <VBox spacing="10" styleClass="sidebar" prefWidth="300" style="-fx-background-color: #1e293b; -fx-padding: 20;">
            <Label fx:id="userInfoLabel" text="Dashboard RH" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" wrapText="true"/>
            <Region prefHeight="20"/>
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Button text="Gestion des Congés" onAction="#showCongesManagement" maxWidth="Infinity" styleClass="sidebar-button"/>
                <Button text="Planning Projets" onAction="#showProjects" maxWidth="Infinity" styleClass="sidebar-button"/>
                <Button text="Planning Sprints" onAction="#showSprints" maxWidth="Infinity" styleClass="sidebar-button"/>
            </VBox>
            <Button text="Déconnexion" onAction="#logout" maxWidth="Infinity" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #f8fafc; -fx-padding: 20;">
            <!-- Conges Management View -->
            <VBox fx:id="congesView" spacing="15" visible="false">
                <Label text="Gestion des Congés" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

                <!-- Congé Form -->
                <GridPane hgap="15" vgap="12" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-padding: 15;">
                    <columnConstraints>
                        <ColumnConstraints minWidth="10" prefWidth="120"/>
                        <ColumnConstraints minWidth="10" prefWidth="200" hgrow="SOMETIMES"/>
                        <ColumnConstraints minWidth="10" prefWidth="100"/>
                        <ColumnConstraints minWidth="10" prefWidth="200" hgrow="SOMETIMES"/>
                        <ColumnConstraints minWidth="10" prefWidth="100"/>
                        <ColumnConstraints minWidth="10" prefWidth="200" hgrow="SOMETIMES"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10" prefHeight="35" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="10" prefHeight="35" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="10" prefHeight="35" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="10" prefHeight="35" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <children>
                        <Label text="CIN Employé:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                        <TextField fx:id="txtCinEmploye" prefHeight="32" promptText="Ex: 12345678" style="-fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Type:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                        <ComboBox fx:id="cbType" prefHeight="32" prefWidth="200" style="-fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                        <Label text="Date début:" GridPane.columnIndex="4" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                        <DatePicker fx:id="dpDateDebut" prefHeight="32" prefWidth="200" promptText="JJ/MM/AAAA" style="-fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;" GridPane.columnIndex="5" GridPane.rowIndex="0"/>

                        <Label text="Date fin:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                        <DatePicker fx:id="dpDateFin" prefHeight="32" prefWidth="200" promptText="JJ/MM/AAAA" style="-fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                        <Label text="Nbr jours:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                        <TextField fx:id="txtNbrJours" prefHeight="32" promptText="Ex: 5" style="-fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label text="Justificatif:" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                        <TextField fx:id="txtDjon" prefHeight="32" promptText="Chemin ou description" style="-fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;" GridPane.columnIndex="3" GridPane.columnSpan="3" GridPane.rowIndex="2"/>

                        <Label text="Congé soldé (0/1):" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold; -fx-font-size: 13;"/>
                        <TextField fx:id="txtCongeSolde" prefHeight="32" promptText="0 ou 1" style="-fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    </children>
                </GridPane>

                <!-- Filter row -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Filtrer:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="filterStatutCombo" promptText="Filtrer par statut" onAction="#filterConges" style="-fx-min-width: 150px;"/>
                </HBox>

                <!-- Congé Table -->
                <TableView fx:id="congesTable" prefHeight="350" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idCongeColumn" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="employeColumn" text="Employé" prefWidth="180"/>
                        <TableColumn fx:id="typeColumn" text="Type" prefWidth="110"/>
                        <TableColumn fx:id="dateDebutColumn" text="Date Début" prefWidth="110"/>
                        <TableColumn fx:id="dateFinColumn" text="Date Fin" prefWidth="110"/>
                        <TableColumn fx:id="nbrJoursColumn" text="Jours" prefWidth="70"/>
                        <TableColumn fx:id="statutColumn" text="Statut" prefWidth="110"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="12" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-padding: 10;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#demanderConge" prefHeight="40" prefWidth="160" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Demander">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#annulerConge" prefHeight="40" prefWidth="180" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Annuler (EN_ATTENTE)">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#accepterConge" prefHeight="40" prefWidth="160" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Accepter (RH)">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#refuserConge" prefHeight="40" prefWidth="160" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Refuser (RH)">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#refreshConges" prefHeight="40" prefWidth="80" style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 18;" text="⟳">
                            <cursor><Cursor fx:constant="HAND"/></cursor>
                        </Button>
                    </children>
                </HBox>
            </VBox>
            
            <!-- Welcome View -->
            <VBox fx:id="welcomeView" spacing="20" alignment="CENTER" visible="true">
                <Label text="Bienvenue dans l'Espace RH" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
