<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>

<ScrollPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.CongesController" fitToWidth="true" 
            style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0; -fx-border-width: 0;"
            stylesheets="@../assets/style.css">
    <VBox spacing="20" styleClass="content-area">
        <padding>
            <Insets top="24" right="30" bottom="30" left="30"/>
        </padding>

        <VBox spacing="4">
            <Label text="Gestion des Congés" styleClass="page-title"/>
            <Label text="Demandez, acceptez ou refusez les congés des employés." styleClass="page-subtitle"/>
        </VBox>

        <!-- ── Inline Stats Row ── -->
        <HBox spacing="16" alignment="CENTER">
            <VBox styleClass="stat-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                  style="-fx-border-color: #f59e0b; -fx-border-width: 0 0 3 0; -fx-border-radius: 0 0 14 14;">
                <Label text="⏳" style="-fx-font-size: 22px;"/>
                <Label fx:id="lblEnAttenteCount" text="0" styleClass="stat-number" style="-fx-text-fill: #f59e0b;"/>
                <Label text="En attente" styleClass="stat-label"/>
            </VBox>
            <VBox styleClass="stat-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                  style="-fx-border-color: #10b981; -fx-border-width: 0 0 3 0; -fx-border-radius: 0 0 14 14;">
                <Label text="✅" style="-fx-font-size: 22px;"/>
                <Label fx:id="lblAccepteCount" text="0" styleClass="stat-number" style="-fx-text-fill: #10b981;"/>
                <Label text="Acceptés" styleClass="stat-label"/>
            </VBox>
            <VBox styleClass="stat-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                  style="-fx-border-color: #ef4444; -fx-border-width: 0 0 3 0; -fx-border-radius: 0 0 14 14;">
                <Label text="❌" style="-fx-font-size: 22px;"/>
                <Label fx:id="lblRefuseCount" text="0" styleClass="stat-number" style="-fx-text-fill: #ef4444;"/>
                <Label text="Refusés" styleClass="stat-label"/>
            </VBox>
            <VBox styleClass="stat-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                  style="-fx-border-color: #64748b; -fx-border-width: 0 0 3 0; -fx-border-radius: 0 0 14 14;">
                <Label text="↩" style="-fx-font-size: 22px;"/>
                <Label fx:id="lblAnnuleCount" text="0" styleClass="stat-number" style="-fx-text-fill: #64748b;"/>
                <Label text="Annulés" styleClass="stat-label"/>
            </VBox>

            <!-- Mini Pie Chart -->
            <VBox styleClass="card" alignment="CENTER" prefWidth="220" style="-fx-padding: 8;">
                <PieChart fx:id="congesMiniChart" prefHeight="140" prefWidth="200"
                          labelsVisible="false" legendVisible="false" animated="true"
                          style="-fx-padding: 0;"/>
            </VBox>
        </HBox>

        <!-- Form Card -->
        <VBox styleClass="card" spacing="16">
            <Label text="📋  Nouvelle Demande de Congé" styleClass="card-title"/>

            <GridPane hgap="24" vgap="16">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="240"/>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="240"/>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="240"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints vgrow="SOMETIMES"/>
                    <RowConstraints vgrow="SOMETIMES"/>
                    <RowConstraints vgrow="SOMETIMES"/>
                </rowConstraints>
                <children>
                    <!-- Row 0 -->
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="CIN Employé" styleClass="form-field-label"/>
                        <TextField fx:id="txtCinEmploye" prefHeight="38" promptText="Ex: 12345678" style="-fx-background-radius: 6;"/>
                        <Label fx:id="errCin" textFill="#ef4444" style="-fx-font-size: 11px; -fx-font-weight: bold;" visible="false"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Type de Congé" styleClass="form-field-label"/>
                        <ComboBox fx:id="cbType" prefHeight="38" maxWidth="Infinity" style="-fx-background-radius: 6;" editable="true" promptText="Choisir ou taper..."/>
                        <Label fx:id="errType" textFill="#ef4444" style="-fx-font-size: 11px; -fx-font-weight: bold;" visible="false"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Date de Début" styleClass="form-field-label"/>
                        <DatePicker fx:id="dpDateDebut" prefHeight="38" maxWidth="Infinity" promptText="JJ/MM/AAAA"/>
                        <Label fx:id="errDebut" textFill="#ef4444" style="-fx-font-size: 11px; -fx-font-weight: bold;" visible="false"/>
                    </VBox>

                    <!-- Row 1 -->
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Date de Fin" styleClass="form-field-label"/>
                        <DatePicker fx:id="dpDateFin" prefHeight="38" maxWidth="Infinity" promptText="JJ/MM/AAAA"/>
                        <Label fx:id="errFin" textFill="#ef4444" style="-fx-font-size: 11px; -fx-font-weight: bold;" visible="false"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Nombre de Jours" styleClass="form-field-label"/>
                        <TextField fx:id="txtNbrJours" prefHeight="38" promptText="Calculé auto." editable="false" 
                                   style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-text-fill: #64748b;"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <Label text="Solde Disponible" styleClass="form-field-label"/>
                        <HBox alignment="CENTER_LEFT" prefHeight="38" style="-fx-background-color: #f0fdf4; -fx-background-radius: 6; -fx-padding: 0 12; -fx-border-color: #bbf7d0; -fx-border-radius: 6;">
                            <Label fx:id="lblSoldeCalculated" text="--" style="-fx-text-fill: #16a34a; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                        </HBox>
                    </VBox>

                    <!-- Row 2 -->
                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="3">
                        <Label text="Justificatif (Commentaire ou document)" styleClass="form-field-label"/>
                        <HBox spacing="8">
                            <TextField fx:id="txtDjon" prefHeight="38" promptText="Détails de la demande ou chemin du fichier..." HBox.hgrow="ALWAYS" style="-fx-background-radius: 6 0 0 6;"/>
                            <Button text="📁 Upload" onAction="#handleUploadFile" prefHeight="38"
                                    style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 0 6 6 0; -fx-cursor: hand; -fx-padding: 0 16;"/>
                        </HBox>
                        <Label fx:id="errJustificatif" textFill="#ef4444" style="-fx-font-size: 11px; -fx-font-weight: bold;" visible="false"/>
                    </VBox>
                </children>
            </GridPane>
        </VBox>

        <!-- Filter row -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="🔍  Filtrer par statut :" styleClass="form-field-label"/>
            <ComboBox fx:id="filterStatutCombo" promptText="Tous les statuts" onAction="#filterConges"
                       style="-fx-min-width: 180px; -fx-background-radius: 8; -fx-border-radius: 8;"/>
        </HBox>

        <!-- Table Card -->
        <VBox VBox.vgrow="ALWAYS" styleClass="card" spacing="14">
            <Label text="Liste des Congés" styleClass="card-title"/>

            <TableView fx:id="congesTable" prefHeight="280" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idCongeColumn"   text="ID"         prefWidth="60"/>
                    <TableColumn fx:id="employeColumn"   text="Employé"    prefWidth="180"/>
                    <TableColumn fx:id="typeColumn"      text="Type"       prefWidth="120"/>
                    <TableColumn fx:id="dateDebutColumn" text="Date Début" prefWidth="120"/>
                    <TableColumn fx:id="dateFinColumn"   text="Date Fin"   prefWidth="120"/>
                    <TableColumn fx:id="nbrJoursColumn"  text="Jours"      prefWidth="70"/>
                    <TableColumn fx:id="statutColumn"    text="Statut"     prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Action Buttons -->
        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnDemander" mnemonicParsing="false" onAction="#demanderConge"  prefHeight="42" prefWidth="140"
                    text="📝  Demander"
                    style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;"/>
            <Button fx:id="btnAnnuler" mnemonicParsing="false" onAction="#annulerConge"   prefHeight="42" prefWidth="190"
                    text="↩  Annuler"
                    style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;"/>
            <Button fx:id="btnAccepter" mnemonicParsing="false" onAction="#accepterConge"  prefHeight="42" prefWidth="160"
                    text="✅  Accepter"
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;"/>
            <Button fx:id="btnRefuser" mnemonicParsing="false" onAction="#refuserConge"   prefHeight="42" prefWidth="160"
                    text="❌  Refuser"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13px;"/>
            <Button mnemonicParsing="false" onAction="#refreshConges"  prefHeight="42" prefWidth="56"
                    text="⟳"
                    style="-fx-background-color: #06b6d4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 18px;"/>
        </HBox>
        
        <!-- Bottom spacer -->
        <Region prefHeight="10"/>
    </VBox>
</ScrollPane>
