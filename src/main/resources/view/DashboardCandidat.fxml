<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.DashboardCandidatController"
            stylesheets="@../assets/style.css" prefWidth="1280" prefHeight="800">

    <left>
        <VBox styleClass="sidebar" prefWidth="240" spacing="0">
            <!-- Top Part -->
            <VBox spacing="2" style="-fx-padding: 28 20 20 20;">
                <Label text="⚡ PlanUp" styleClass="sidebar-logo" style="-fx-padding: 0;"/>
                <Label text="Espace Employé" styleClass="sidebar-logo-sub" style="-fx-padding: 0;"/>
            </VBox>
            <Region prefHeight="1" style="-fx-background-color: #1e293b;" maxWidth="Infinity"/>
            <VBox style="-fx-padding: 16 16 0 16;">
                <VBox styleClass="sidebar-user-box" spacing="2">
                    <Label fx:id="userInfoLabel" text="Employé" styleClass="sidebar-user-name" wrapText="true"/>
                    <Label text="🏢 EMPLOYÉ" styleClass="sidebar-user-role"/>
                </VBox>
            </VBox>
            
            <!-- Middle Part -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0; -fx-border-width: 0;">
                <VBox spacing="2" style="-fx-padding: 0 12;">
                    <Button text="💼 Parcourir les Offres" onAction="#showOffres" maxWidth="Infinity" styleClass="sidebar-button"/>
                    <Button text="📑 Mes Candidatures" onAction="#showMesCandidatures" maxWidth="Infinity" styleClass="sidebar-button"/>
                </VBox>
            </ScrollPane>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Bottom Part -->
            <VBox spacing="6" style="-fx-padding: 12 12 20 12;">
                <Button text="👤 Mon Profil"    onAction="#showProfile" maxWidth="Infinity" styleClass="sidebar-button-profile"/>
                <Button text="🚪 Déconnexion"   onAction="#logout"      maxWidth="Infinity" styleClass="sidebar-button-logout"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">

            <VBox fx:id="welcomeView" spacing="20" style="-fx-padding: 20;">

                <VBox spacing="6">
                    <Label text="Parcourir les Offres d'Emploi" styleClass="page-title"/>
                    <Label text="Découvrez les meilleures opportunités d'emploi et postulez facilement." styleClass="page-subtitle"/>
                </VBox>

 
                <VBox styleClass="welcome-banner" spacing="6">
                    <Label text="Bienvenue dans votre Espace Candidat" styleClass="welcome-title"/>
                    <Label text="Parcourez les offres, candidatez et suivez l'état de vos candidatures." styleClass="welcome-subtitle"/>
                </VBox>

                <HBox spacing="16" VBox.vgrow="ALWAYS">
           
                    <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                        <Label text="Offres d'Emploi Disponibles" styleClass="card-title"/>
                        
                        <TableView fx:id="offresTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="titreCol" text="Titre" prefWidth="140"/>
                                <TableColumn fx:id="entrepriseCol" text="Entreprise" prefWidth="110"/>
                                <TableColumn fx:id="salaireCol" text="Salaire" prefWidth="90"/>
                                <TableColumn fx:id="typeContratCol" text="Type Contrat" prefWidth="100"/>
                                <TableColumn fx:id="localisationCol" text="Localisation" prefWidth="110"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                    <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                        <Label text="Détails de l'Offre" styleClass="card-title"/>
                        
                        <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-padding: 10;">
                            <Label text="Description:" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                            <TextArea fx:id="descriptionArea" wrapText="true" prefHeight="80" editable="false" style="-fx-control-inner-background: #f1f5f9; -fx-padding: 8;"/>
                            
                            <Label fx:id="detailsSalaireLabel" text="Salaire: " style="-fx-font-size: 12; -fx-text-fill: #10b981;"/>
                            <Label fx:id="detailsTypeContratLabel" text="Type Contrat: " style="-fx-font-size: 12; -fx-text-fill: #6366f1;"/>
                            <Label fx:id="detailsLocalisationLabel" text="Localisation: " style="-fx-font-size: 12; -fx-text-fill: #f59e0b;"/>
                            
                            <Separator style="-fx-padding: 5 0;"/>
                            
                            <Label text="Lettre de Motivation:" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                            <TextArea fx:id="lettreMotivationArea" wrapText="true" prefHeight="70" promptText="Écrivez votre lettre de motivation ici..." style="-fx-control-inner-background: #f1f5f9; -fx-padding: 8;"/>
                            
                            <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                                <Button fx:id="candidaterButton" text="Submit" 
                                        style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" 
                                        onAction="#handleCandidater" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </HBox>

            </VBox>

            <VBox fx:id="mesCandidaturesView" spacing="20" style="-fx-padding: 20;">

                <VBox spacing="6">
                    <Label text="Mes Candidatures" styleClass="page-title"/>
                    <Label text="Suivez l'état de toutes vos candidatures et les offres auxquelles vous avez postulé." styleClass="page-subtitle"/>
                </VBox>

                <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS">
                    <Label text=" Historique des Candidatures" styleClass="card-title"/>
                    
                    <TableView fx:id="mesCandidaturesTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="offreTitleCol" text="Offre d'Emploi" prefWidth="250"/>
                            <TableColumn fx:id="datePostulationCol" text="Date de Postulation" prefWidth="150"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

            </VBox>

        </StackPane>
    </center>

</BorderPane>
