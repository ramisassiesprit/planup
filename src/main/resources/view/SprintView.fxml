<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.SprintController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Gestion des Sprints" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nom du Sprint:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Projet:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="projectComboBox" prefWidth="200" promptText="Sélectionner un projet" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Button text="Ajouter" onAction="#handleAddSprint"/>
            <Button text="Vider" onAction="#clearFields"/>
        </HBox>
    </GridPane>

    <TableView fx:id="sprintTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="nameColumn" text="Nom du Sprint" prefWidth="150"/>
            <TableColumn fx:id="projectColumn" text="Projet" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
