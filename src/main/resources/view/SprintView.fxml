<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.SprintController"
      spacing="24" styleClass="content-area"
      stylesheets="@../assets/style.css">

    <!-- Page Header -->
    <VBox spacing="4">
        <Label text="Gestion des Sprints" styleClass="page-title"/>
        <Label text="Créez et organisez vos sprints par projet." styleClass="page-subtitle"/>
    </VBox>

    <!-- Form Card -->
    <VBox styleClass="card" spacing="18">
        <Label fx:id="formTitle" text="🔄  Informations du Sprint" styleClass="card-title"/>

        <GridPane hgap="16" vgap="12">
            <columnConstraints>
                <ColumnConstraints minWidth="110" prefWidth="150"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label fx:id="nameLabel" text="Nom du Sprint :" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="form-field-label"/>
            <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"
                       promptText="Ex: Sprint 1 — Authentification"/>

            <Label text="Projet :" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="form-field-label"/>
            <ComboBox fx:id="projectComboBox" GridPane.columnIndex="1" GridPane.rowIndex="1"
                      promptText="Sélectionner un projet" maxWidth="Infinity"/>
        </GridPane>

        <!-- Action Buttons -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="btnAdd"    text="➕  Ajouter"             onAction="#handleAdd"
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="btnUpdate" text="✏️  Modifier"            onAction="#handleUpdate"
                    style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="btnDelete" text="🗑️  Supprimer"           onAction="#handleDelete"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button fx:id="btnFilter" text="🔍  Filtrer par Projet"  onAction="#handleFilter"
                    style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button text="🔄  Effacer"                                 onAction="#handleClear"
                    style="-fx-background-color: #e2e8f0; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <!-- Table Card -->
    <VBox VBox.vgrow="ALWAYS" styleClass="card" spacing="14">
        <Label text="Liste des Sprints" styleClass="card-title"/>

        <TableView fx:id="sprintTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId"      text="ID"           prefWidth="80"  style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colName"    text="Nom du Sprint" prefWidth="310"/>
                <TableColumn fx:id="colProject" text="Projet"        prefWidth="260"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
