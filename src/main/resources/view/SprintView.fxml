<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.SprintController"
      spacing="20" style="-fx-background-color: #f8fafc; -fx-padding: 30;">

    <!-- Titre -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Gestion des Sprints" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
    </HBox>

    <!-- Formulaire -->
    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <Label fx:id="formTitle" text="Informations du Sprint" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
        
        <GridPane hgap="15" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="100" prefWidth="150"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label fx:id="nameLabel" text="Nom du Sprint :" GridPane.columnIndex="0" GridPane.rowIndex="0" 
                   style="-fx-text-fill: #475569;"/>
            <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                       promptText="Ex: Sprint 1 - Authentification" 
                       style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #e2e8f0; -fx-border-radius: 5;"/>

            <Label text="Projet :" GridPane.columnIndex="0" GridPane.rowIndex="1" 
                   style="-fx-text-fill: #475569;"/>
            <ComboBox fx:id="projectComboBox" GridPane.columnIndex="1" GridPane.rowIndex="1" 
                      promptText="Sélectionner un projet" maxWidth="Infinity"
                      style="-fx-padding: 5; -fx-background-radius: 5;"/>
        </GridPane>

        <!-- Boutons d'action -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="btnAdd" text="Ajouter" onAction="#handleAdd" 
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5; -fx-font-weight: bold;"/>
            <Button fx:id="btnUpdate" text="Modifier" onAction="#handleUpdate" 
                    style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5; -fx-font-weight: bold;"/>
            <Button fx:id="btnDelete" text="Supprimer" onAction="#handleDelete" 
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5; -fx-font-weight: bold;"/>
            <Button fx:id="btnFilter" text="Filtrer par Projet" onAction="#handleFilter" 
                    style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5; -fx-font-weight: bold;"/>
            <Button text="Effacer" onAction="#handleClear" 
                    style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>

    <!-- Tableau -->
    <VBox VBox.vgrow="ALWAYS" spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <Label text="Liste des Sprints" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
        
        <TableView fx:id="sprintTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="80" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colName" text="Nom du Sprint" prefWidth="300"/>
                <TableColumn fx:id="colProject" text="Projet" prefWidth="250"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
