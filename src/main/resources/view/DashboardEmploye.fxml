<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.DashboardEmployeController"
 stylesheets="@../assets/style.css" prefWidth="1024" prefHeight="768">
 <left>
    <VBox spacing="10" styleClass="sidebar" prefWidth="300" style="-fx-background-color: #1e293b; -fx-padding: 20;">
        <Label fx:id="userInfoLabel" text="Dashboard EMPLOYE" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" wrapText="true"/>
        
        <Button text="Profil" onAction="#showProfile" maxWidth="Infinity" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Déconnexion" onAction="#logout" maxWidth="Infinity" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </VBox>
 </left>
 <center>
    <StackPane fx:id="contentArea" style="-fx-background-color: #f8fafc; -fx-padding: 40;">
        <VBox spacing="20" alignment="CENTER">
            <Label text="Bienvenue dans l'Espace Employé" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        </VBox>
    </StackPane>
 </center>
</BorderPane>
