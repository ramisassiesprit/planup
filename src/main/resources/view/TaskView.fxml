<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" style="-fx-background-color: #f8fafc; -fx-padding: 30;" xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.TaskController">
    <Label text="Gestion des Tâches" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Formulaire de CRUD (Admin/Manager) -->
        <VBox fx:id="formContainer" spacing="10" prefWidth="350" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <Label text="Détails de la Tâche" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
            
            <TextField fx:id="nameField" promptText="Nom de la tâche"/>
            <TextArea fx:id="descArea" promptText="Description" prefRowCount="3"/>
            <DatePicker fx:id="deadlinePicker" promptText="Date limite" maxWidth="Infinity"/>
            <TextField fx:id="priorityField" promptText="Priorité (1-5)"/>
            <TextField fx:id="estimationField" promptText="Estimation (heures)"/>
            
            <Label text="Sprint"/>
            <ComboBox fx:id="sprintCombo" maxWidth="Infinity" promptText="Sélectionner Sprint"/>
            
            <Label text="Assignation (Manager)"/>
            <HBox spacing="10">
                <ComboBox fx:id="assigneeCombo" maxWidth="Infinity" promptText="Assigner à..." HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAssign" text="Assigner" onAction="#handleAssign" style="-fx-background-color: #f59e0b; -fx-text-fill: white;"/>
            </HBox>

            <Separator/>
            
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="btnAdd" text="Ajouter" onAction="#handleAdd" style="-fx-background-color: #22c55e; -fx-text-fill: white;" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnUpdate" text="Modifier" onAction="#handleUpdate" style="-fx-background-color: #3b82f6; -fx-text-fill: white;" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="btnDelete" text="Supprimer" onAction="#handleDelete" style="-fx-background-color: #ef4444; -fx-text-fill: white;" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Vider" onAction="#handleClear" style="-fx-background-color: #64748b; -fx-text-fill: white;" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <!-- Liste des tâches et changement de statut -->
        <VBox spacing="15" HBox.hgrow="ALWAYS">
            <!-- Container pour le statut (Dev/Int) -->
            <VBox fx:id="statusContainer" spacing="10" style="-fx-background-color: #fef3c7; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #f59e0b; -fx-border-radius: 8;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Changer le statut de la tâche sélectionnée :" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="statusCombo" promptText="Nouveau statut"/>
                    <Button text="Mettre à jour" onAction="#handleStatusChange" style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <TableView fx:id="taskTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10;">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colName" text="Titre" prefWidth="200"/>
                    <TableColumn fx:id="colStatus" text="Statut" prefWidth="150"/>
                    <TableColumn fx:id="colAssignee" text="Assigné à" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
</VBox>
