<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.DashboardAdminController"
            stylesheets="@../assets/style.css" prefWidth="1200" prefHeight="800">

    <!-- ══════════════════════════════════════════════════════════
         SIDEBAR
    ══════════════════════════════════════════════════════════ -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240" spacing="0">

            <!-- Logo -->
            <VBox spacing="2" style="-fx-padding: 28 20 20 20;">
                <Label text="⚡ PlanUp" styleClass="sidebar-logo" style="-fx-padding: 0;"/>
                <Label text="Espace Administrateur" styleClass="sidebar-logo-sub" style="-fx-padding: 0;"/>
            </VBox>

            <!-- Divider -->
            <Region prefHeight="1" style="-fx-background-color: #1e293b;" maxWidth="Infinity"/>

            <!-- User info -->
            <VBox style="-fx-padding: 16 16 0 16;">
                <VBox styleClass="sidebar-user-box" spacing="2">
                    <Label fx:id="userInfoLabel" text="Administrateur" styleClass="sidebar-user-name" wrapText="true"/>
                    <Label text="👑 ADMIN" styleClass="sidebar-user-role"/>
                </VBox>
            </VBox>

            <!-- Navigation Label -->
            <Label text="NAVIGATION" styleClass="sidebar-section-label"/>

            <!-- Nav Buttons -->
            <VBox spacing="2" style="-fx-padding: 0 12;" VBox.vgrow="ALWAYS">
                <Button text="👥  Utilisateurs"  onAction="#showUsers"    maxWidth="Infinity" styleClass="sidebar-button"/>
                <Button text="🏖️  Gestion des Congés" onAction="#showCongesManagement" maxWidth="Infinity" styleClass="sidebar-button"/>
                <Button text="📁  Projets"        onAction="#showProjects" maxWidth="Infinity" styleClass="sidebar-button"/>
                <Button text="🔄  Sprints"         onAction="#showSprints"  maxWidth="Infinity" styleClass="sidebar-button"/>
                <Button text="✅  Tâches"           onAction="#showTasks"    maxWidth="Infinity" styleClass="sidebar-button"/>
            </VBox>

            <!-- Bottom buttons -->
            <VBox spacing="6" style="-fx-padding: 12;">
                <Button text="👤  Mon Profil"    onAction="#showProfile" maxWidth="Infinity" styleClass="sidebar-button-profile"/>
                <Button text="🚪  Déconnexion"   onAction="#logout"      maxWidth="Infinity" styleClass="sidebar-button-logout"/>
            </VBox>

        </VBox>
    </left>

    <!-- ══════════════════════════════════════════════════════════
         MAIN CONTENT
    ══════════════════════════════════════════════════════════ -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">

            <!-- Default Welcome View -->
            <VBox fx:id="mainUserView" spacing="28">

                <!-- Page header -->
                <VBox spacing="6">
                    <Label text="Tableau de Bord" styleClass="page-title"/>
                    <Label text="Gérez vos utilisateurs, projets, sprints et tâches." styleClass="page-subtitle"/>
                </VBox>

                <!-- Welcome banner -->
                <VBox styleClass="welcome-banner" spacing="6">
                    <Label text="👋 Bienvenue dans l'Espace Administrateur" styleClass="welcome-title"/>
                    <Label text="Vous avez accès complet à tous les modules de PlanUp." styleClass="welcome-subtitle"/>
                </VBox>

                <!-- Toolbar -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button text="➕  Créer Utilisateur" onAction="#onCreateUser"
                            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Filtrer par rôle:" style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                    <ComboBox fx:id="roleFilterComboBox" promptText="Tous les rôles"
                              style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;"/>
                </HBox>

                <!-- Table Card -->
                <VBox VBox.vgrow="ALWAYS" styleClass="card" spacing="16">
                    <Label text="Liste des Utilisateurs" styleClass="card-title"/>
                    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS"
                               style="-fx-background-radius: 8;">
                        <columns>
                            <TableColumn fx:id="cinColumn"    text="CIN"       prefWidth="100"/>
                            <TableColumn fx:id="nomColumn"    text="Nom"       prefWidth="140"/>
                            <TableColumn fx:id="prenomColumn" text="Prénom"    prefWidth="140"/>
                            <TableColumn fx:id="emailColumn"  text="Email"     prefWidth="220"/>
                            <TableColumn fx:id="telColumn"    text="Téléphone" prefWidth="130"/>
                            <TableColumn fx:id="roleColumn"   text="Rôle"      prefWidth="110"/>
                            <TableColumn fx:id="editColumn"   text="Éditer"    prefWidth="80"/>
                            <TableColumn fx:id="deleteColumn" text="Supprimer" prefWidth="90"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>

        </StackPane>
    </center>

</BorderPane>
