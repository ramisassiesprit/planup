<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.DashboardAdminController"
            stylesheets="@../assets/style.css" prefWidth="1024" prefHeight="768">
    
    <!-- Sidebar -->
    <left>
        <VBox spacing="10" styleClass="sidebar" prefWidth="300" style="-fx-background-color: #1e293b; -fx-padding: 20;">
            <Label fx:id="userInfoLabel" text="Dashboard ADMIN" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" wrapText="true"/>
            <Region prefHeight="20"/>
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Button text="Projets" onAction="#showProjects" maxWidth="Infinity" styleClass="sidebar-button"/>
                <Button text="Sprints" onAction="#showSprints" maxWidth="Infinity" styleClass="sidebar-button"/>
                <Button text="Tâches" onAction="#showTasks" maxWidth="Infinity" styleClass="sidebar-button"/>
                <Button text="Utilisateurs" onAction="#showUsers" maxWidth="Infinity" styleClass="sidebar-button"/>
            </VBox>
            <Button text="Déconnexion" onAction="#logout" maxWidth="Infinity" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #f8fafc; -fx-padding: 40;">
            <VBox fx:id="mainUserView" spacing="20">
                <Label text="Bienvenue dans l'Espace Administrateur" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <HBox spacing="10">
                    <Button text="Créer Utilisateur" onAction="#onCreateUser" style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-weight: bold;" />
                </HBox>
                <TableView fx:id="usersTable" prefHeight="500">
                    <columns>
                        <TableColumn fx:id="cinColumn" text="CIN" prefWidth="100" />
                        <TableColumn fx:id="nomColumn" text="Nom" prefWidth="150" />
                        <TableColumn fx:id="prenomColumn" text="Prénom" prefWidth="150" />
                        <TableColumn fx:id="emailColumn" text="Email" prefWidth="220" />
                        <TableColumn fx:id="telColumn" text="Téléphone" prefWidth="140" />
                        <TableColumn fx:id="roleColumn" text="Rôle" prefWidth="120" />
                        <TableColumn fx:id="editColumn" text="Editer" prefWidth="80" />
                        <TableColumn fx:id="deleteColumn" text="Supprimer" prefWidth="100" />
                    </columns>
                </TableView>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
